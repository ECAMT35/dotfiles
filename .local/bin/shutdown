#!/bin/bash
set -e

icon_cross=$'\uf00d'
icon_power=$'\uf011'
icon_clock=$'\uf017'
icon_dot=$'\uf111'
icon_moon=$'\uf186'
icon_check=$'\uf00c'

interrupt_shutdown() {
    printf "\n  %s  已取消关机，系统继续运行。\n" "$icon_cross"
    exit 0
}

trap interrupt_shutdown SIGINT

read -r -p "  $icon_power  确定关机吗？(y/其他): " user_choice
user_choice=$(echo "$user_choice" | tr '[:upper:]' '[:lower:]')

if [ "$user_choice" = "y" ]; then
    printf "\n  %s  3 秒后关机，按 Ctrl+C 取消...\n\n" "$icon_clock"

    for i in 3 2 1; do
        printf "  %s  %d...\r" "$icon_dot" "$i"
        sleep 1
    done

    printf "\n\n  %s  晚安 Master。\n" "$icon_moon"
    sleep 0.8
    /sbin/shutdown -h now
else
    printf "\n  %s  已取消。\n" "$icon_check"
fi
